<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent>
    </queries>
    <application android:theme="@style/AppTheme" android:label="Roam Launcher" android:icon="@drawable/banner" android:banner="@drawable/banner" android:allowBackup="false" android:supportsRtl="true">
        <meta-data android:name="android.software.leanback.supports_touch" android:value="true"/>
        <activity android:name=".SaverActivity" android:exported="false" android:screenOrientation="fullUser"/>
        <activity android:name=".DiagnosticActivity" android:exported="false" android:screenOrientation="fullUser"/>
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="fullUser" android:launchMode="singleTask">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
